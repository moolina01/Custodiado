# Copy this file to .env.local and fill in real values. .env.local is
# gitignored — never commit real secrets. See plan-escrow.md and
# /Users/maury/.claude/plans/revisa-el-siguente-docuemtno-twinkling-ocean.md
# for where each of these comes from.

# --- Fintoc (server-only — never expose with a NEXT_PUBLIC_ prefix) ---

# Developers -> API Keys -> secret key (test mode: sk_test_...)
FINTOC_SECRET_KEY=

# The platform's single Fintoc Account that receives every inbound transfer
# and sends every outbound release/refund (acc_...).
FINTOC_ACCOUNT_ID=

# The account_number_id used by /v2/simulate/receive_transfer. NOT the same
# as the raw root_account_number digits shown in the Fintoc dashboard —
# resolve via fintoc.v2.accountNumbers.list(...) once credentials are live.
FINTOC_ACCOUNT_NUMBER_ID=

# The plain account number digits, shown to buyers as "transfer to this
# account" — not secret, same idea as sharing a bank account number.
FINTOC_ROOT_ACCOUNT_NUMBER=

# RSA private key (PEM), generated via:
#   openssl genrsa -out private_key.pem 2048
#   openssl rsa -in private_key.pem -outform PEM -pubout -out public_key.pem
# Upload public_key.pem in the dashboard (API Keys -> JWS Public Keys).
# Never commit private_key.pem itself (already covered by .gitignore's *.pem).
# Paste the full PEM here, literal newlines are fine in .env.local:
FINTOC_JWS_PRIVATE_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----
...
-----END RSA PRIVATE KEY-----"

# Dashboard -> Webhooks -> your endpoint's signing secret. Verified with
# WebhookSignature.verifyHeader() from the `fintoc` package.
FINTOC_WEBHOOK_SECRET=

# --- QR verifier (server-only) ---

# HMAC-SHA256 key used to sign/verify the 30s-lived QR tokens shown on the
# seller's screen and scanned by the buyer's camera (lib/tratos/qrToken.ts).
# Same pattern as FINTOC_WEBHOOK_SECRET: a long random string, e.g.
#   openssl rand -base64 32
QR_SIGNING_SECRET=

# --- Supabase (server-only — the client never talks to Supabase directly) ---

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# SPEC 04: anon/publishable key, used ONLY server-side (Route Handlers under
# app/api/auth/* and proxy.ts) to run Supabase Auth (signup/login/logout/
# reset password) scoped to the caller's own session cookies. Different key,
# different purpose than SUPABASE_SERVICE_ROLE_KEY above: this one respects
# RLS and can only ever act as the signed-in user, never as an admin. Still
# no NEXT_PUBLIC_ prefix — the browser keeps not talking to Supabase
# directly, same invariant as today, just two server-only clients now
# instead of one (see lib/supabase/authClient.ts vs lib/supabase/server.ts).
SUPABASE_ANON_KEY=

# --- App ---

# Used to build absolute URLs (e.g. links shared over WhatsApp).
APP_BASE_URL=http://localhost:3000
