# Copy this file to .env.local and fill in real values. .env.local is
# gitignored — never commit real secrets. See plan-escrow.md and
# /Users/maury/.claude/plans/revisa-el-siguente-docuemtno-twinkling-ocean.md
# for where each of these comes from.

# --- Mercado Pago ---

# Server-only (never expose with a NEXT_PUBLIC_ prefix). Your integrations
# -> [app] -> Test credentials / Production credentials -> Access Token.
# Used for Checkout API payments, refunds, and Payouts (see lib/mercadopago/).
MERCADOPAGO_ACCESS_TOKEN=

# Client-side — the only Mercado Pago credential the browser ever sees.
# Same place as the access token -> "Public Key". Used by MP.js (loaded in
# components/flujo/steps/PagarStep.tsx) to tokenize the card in-browser;
# the raw card number never reaches this server, only the resulting token.
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# Your integrations -> Webhooks -> "Secret key" — signs the `x-signature`
# header on every notification. Verified in lib/mercadopago/webhooks.ts
# (HMAC-SHA256 over Mercado Pago's own manifest format; see that file's
# comment for the exact scheme, since it isn't wrapped by their SDK).
MERCADOPAGO_WEBHOOK_SECRET=

# ⚠️ Payouts (lib/mercadopago/payouts.ts) is a separate product from regular
# Checkout API access, confirmed BLOCKED for this account by Mercado Pago
# support (Money Out for Chile needs a commercial approval they haven't
# granted — see the warning atop that file). `releaseTrato`
# (lib/tratos/release.ts) no longer calls it: the seller release is now a
# manual transfer by the app's admin, notified by email (see the Resend/
# admin section below). This code stays dormant, not deleted, in case
# Mercado Pago approves Money Out later.

# --- Admin notifications (manual seller payout, lib/tratos/release.ts) ---

# Resend (resend.com) — the admin's own account, not a Vercel Marketplace
# resource. Dashboard -> API Keys.
RESEND_API_KEY=

# The verified sender Resend sends admin notifications from, e.g.
# "Custodiado <notificaciones@custodiado.cl>" — the domain must be verified
# in Resend's dashboard first.
ADMIN_NOTIFICATION_FROM_EMAIL=

# Comma-separated list of account emails allowed into /admin (see
# lib/auth/admin.ts) — must match the email each account signed up with.
# Also who RESEND_API_KEY's notifications go to.
ADMIN_EMAILS=

# --- QR verifier (server-only) ---

# HMAC-SHA256 key used to sign/verify the 30s-lived QR tokens shown on the
# seller's screen and scanned by the buyer's camera (lib/tratos/qrToken.ts).
# Kept working (see components/flujo/releaseMethod.ts) even though the
# 6-digit release code below is the current default — still required.
# Same pattern as MERCADOPAGO_WEBHOOK_SECRET: a long random string, e.g.
#   openssl rand -base64 32
QR_SIGNING_SECRET=

# --- Release code verifier (server-only) ---

# HMAC-SHA256 key used to sign/verify the 45s-lived 6-digit release code
# shown on the buyer's screen and typed in by the seller
# (lib/tratos/releaseCode.ts) — the current default release mechanism (see
# components/flujo/releaseMethod.ts). Same pattern as QR_SIGNING_SECRET, a
# separate key so the two verifiers don't share a secret:
#   openssl rand -base64 32
RELEASE_CODE_SIGNING_SECRET=

# --- Supabase (server-only — the client never talks to Supabase directly) ---

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# SPEC 04: anon/publishable key, used ONLY server-side (Route Handlers under
# app/api/auth/* and proxy.ts) to run Supabase Auth (signup/login/logout/
# reset password) scoped to the caller's own session cookies. Different key,
# different purpose than SUPABASE_SERVICE_ROLE_KEY above: this one respects
# RLS and can only ever act as the signed-in user, never as an admin. Still
# no NEXT_PUBLIC_ prefix — the browser keeps not talking to Supabase
# directly, same invariant as today, just two server-only clients now
# instead of one (see lib/supabase/authClient.ts vs lib/supabase/server.ts).
SUPABASE_ANON_KEY=

# --- App ---

# Used to build absolute URLs (e.g. links shared over WhatsApp).
APP_BASE_URL=http://localhost:3000
